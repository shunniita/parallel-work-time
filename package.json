{
  "name": "parallel-work-time",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "同時並行作業時間計測支援ツール。このファイルは開発時のテストツール定義のみを持ち、配布物へは含めない。",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert @screenshot",
    "test:e2e:shots": "playwright test --grep @screenshot",
    "serve": "node tools/static-server.mjs",
    "dist": "node tools/build-dist.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "vitest": "^4.1.10"
  }
}
